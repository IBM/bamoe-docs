<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" 
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
  xmlns:drools="http://www.jboss.org/drools" 
  id="_test-process" 
  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
  targetNamespace="http://www.omg.org/bpmn20">
  
  <!-- Item Definitions -->
  <bpmn2:itemDefinition id="_messageItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_resultItem" structureRef="String"/>
  
  <bpmn2:process id="testProcess" drools:packageName="com.example" drools:version="1.0" drools:adHoc="false" name="Test Process" isExecutable="true" processType="Public">
    
    <!-- Process Variables -->
    <bpmn2:property id="message" itemSubjectRef="_messageItem" name="message"/>
    <bpmn2:property id="result" itemSubjectRef="_resultItem" name="result"/>
    
    <!-- Start Event -->
    <bpmn2:startEvent id="_1" name="Start">
      <bpmn2:outgoing>_1-_2</bpmn2:outgoing>
    </bpmn2:startEvent>
    
    <!-- User Task -->
    <bpmn2:userTask id="_2" name="ReviewTask">
      <bpmn2:incoming>_1-_2</bpmn2:incoming>
      <bpmn2:outgoing>_2-_3</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_2_TaskNameInputX" drools:dtype="String" name="TaskName"/>
        <bpmn2:dataInput id="_2_SkippableInputX" drools:dtype="Boolean" name="Skippable"/>
        <bpmn2:dataInput id="_2_messageInput" drools:dtype="String" name="message"/>
        <bpmn2:dataOutput id="_2_resultOutput" drools:dtype="String" name="result"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_2_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_2_SkippableInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_2_messageInput</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_2_resultOutput</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_2_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[ReviewTask]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_2_TaskNameInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_2_SkippableInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[false]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_2_SkippableInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>message</bpmn2:sourceRef>
        <bpmn2:targetRef>_2_messageInput</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_2_resultOutput</bpmn2:sourceRef>
        <bpmn2:targetRef>result</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:potentialOwner>
        <bpmn2:resourceAssignmentExpression>
          <bpmn2:formalExpression>john</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>
    
    <!-- End Event -->
    <bpmn2:endEvent id="_3" name="End">
      <bpmn2:incoming>_2-_3</bpmn2:incoming>
    </bpmn2:endEvent>
    
    <!-- Sequence Flows -->
    <bpmn2:sequenceFlow id="_1-_2" sourceRef="_1" targetRef="_2"/>
    <bpmn2:sequenceFlow id="_2-_3" sourceRef="_2" targetRef="_3"/>
  </bpmn2:process>
  
  <!-- Diagram -->
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="testProcess">
      <bpmndi:BPMNShape id="shape__3" bpmnElement="_3">
        <dc:Bounds height="56" width="56" x="600" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__2" bpmnElement="_2">
        <dc:Bounds height="80" width="120" x="350" y="88"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__1" bpmnElement="_1">
        <dc:Bounds height="56" width="56" x="150" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_shape__2_to_shape__3" bpmnElement="_2-_3">
        <di:waypoint x="470" y="128"/>
        <di:waypoint x="600" y="128"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_shape__1_to_shape__2" bpmnElement="_1-_2">
        <di:waypoint x="206" y="128"/>
        <di:waypoint x="350" y="128"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>


