package com.myspace.mortgage_app;

/**
 * This rule is no longer needed in v9 since there's no shared KIE session.
 * However, we keep an empty ruleflow-group to maintain BPMN compatibility.
 * Per IBM documentation: "Since there is no shared KIE session in BAMOE v9, 
 * this rule no longer serves a purpose and can be safely removed."
 */
rule "RetractValidationErr"
    ruleflow-group "error"
    when
        // No conditions - this rule does nothing in v9
    then
        // No actions needed
        System.out.println("Retract Validation rule executed (no-op in v9)");
end