<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jbpm.demo</groupId>
    <artifactId>itorders-v9</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Tutorial 15 - Case Management IT Orders v9</name>
    <description>BAMOE v9 Case Management application for IT hardware orders using Quarkus</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <version.maven-compiler-plugin>3.13.0</version.maven-compiler-plugin>
        <version.maven-surefire-plugin>3.3.1</version.maven-surefire-plugin>

        <!-- Versions -->
        <version.bamoe>9.3.1-ibm-0006</version.bamoe>
        <version.quarkus>3.20.3</version.quarkus>

        <!-- Version overrides for fixing security vulnerabilities -->
        <version.io.vertx>4.5.22</version.io.vertx>
        <version.org.apache.commons.lang3>3.18.0</version.org.apache.commons.lang3>
        <version.org.cyclonedx.java>11.0.1</version.org.cyclonedx.java>
        <version.org.lz4.java>1.8.1</version.org.lz4.java>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Version overrides for transitive dependencies, to fix security vulnerabilities. -->
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-web</artifactId>
                <version>${version.io.vertx}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${version.org.apache.commons.lang3}</version>
            </dependency>
            <dependency>
                <groupId>org.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${version.org.lz4.java}</version>
            </dependency>
            <!-- End of version overrides to fix security vulnerabilities. -->

            <!-- Quarkus BOM -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${version.quarkus}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              The BAMOE BOM manages all dependencies required to create
              Business Services — including Apache KIE, Drools, jBPM, and Kogito
            -->
            <dependency>
                <groupId>com.ibm.bamoe</groupId>
                <artifactId>bamoe-bom</artifactId>
                <version>${version.bamoe}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- BAMOE ILMT -->
        <dependency>
            <groupId>com.ibm.bamoe</groupId>
            <artifactId>bamoe-ilmt-compliance-quarkus-pamoe</artifactId>
        </dependency>

        <!-- Kogito Core -->
        <dependency>
            <groupId>org.jbpm</groupId>
            <artifactId>jbpm-with-drools-quarkus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-addons-quarkus-process-management</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-addons-quarkus-process-svg</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-addons-quarkus-source-files</artifactId>
        </dependency>
        
        <!-- Kogito Persistence -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-addons-quarkus-persistence-jdbc</artifactId>
        </dependency>
        
        <!-- Flyway addon for database schema management -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kie-addons-flyway</artifactId>
        </dependency>

        <!-- Kogito Data-Index (Required for dev-ui process instances visibility) -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kogito-addons-quarkus-data-index-jpa</artifactId>
        </dependency>

        <!-- Kogito Jobs Service -->
        <dependency>
            <groupId>org.kie</groupId>
            <artifactId>kogito-addons-quarkus-embedded-jobs</artifactId>
        </dependency>

        <!-- Quarkus REST (using RESTEasy classic stack for BAMOE compatibility) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-resteasy</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-resteasy-jackson</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>

        <!-- Quarkus Utils -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>

        <!-- BAMOE Dev UI (Required for process instances visibility in dev-ui) -->
        <dependency>
            <groupId>com.ibm.bamoe</groupId>
            <artifactId>bamoe-quarkus-devui</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${version.quarkus}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
                <!-- Version overrides for transitive dependencies, to fix security vulnerabilities. -->
                <dependencies>
                    <dependency>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-core-java</artifactId>
                        <version>${version.org.cyclonedx.java}</version>
                    </dependency>
                    <dependency>
                        <groupId>io.quarkus</groupId>
                        <artifactId>quarkus-cyclonedx-generator</artifactId>
                        <version>${version.quarkus}</version>
                        <exclusions>
                            <exclusion>
                                <groupId>org.cyclonedx</groupId>
                                <artifactId>cyclonedx-core-java</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${version.maven-compiler-plugin}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.maven-surefire-plugin}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${version.maven-surefire-plugin}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                                <maven.home>${maven.home}</maven.home>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.type>native</quarkus.package.type>
            </properties>
        </profile>
    </profiles>
    
</project>

