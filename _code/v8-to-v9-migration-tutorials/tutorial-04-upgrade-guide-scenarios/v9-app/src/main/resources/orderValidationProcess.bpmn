<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_orderValidation" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd http://www.bpsim.org/schemas/1.0 bpsim.xsd http://www.omg.org/spec/DD/20100524/DC DC.xsd http://www.omg.org/spec/DD/20100524/DI DI.xsd " exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_orderItem" structureRef="com.example.upgrade.Order"/>
  <bpmn2:itemDefinition id="__validateOrder_orderInputXItem" structureRef="com.example.upgrade.Order"/>
  <bpmn2:itemDefinition id="__validateOrder_orderOutputXItem" structureRef="com.example.upgrade.Order"/>
  <bpmn2:process id="orderValidationProcess" drools:packageName="com.example.upgrade" drools:version="1.0" drools:adHoc="false" name="Order Validation Process" isExecutable="true">
    <bpmn2:property id="order" itemSubjectRef="_orderItem" name="order"/>
    <bpmn2:sequenceFlow id="_seq1" sourceRef="_start" targetRef="_validateOrder"/>
    <bpmn2:sequenceFlow id="_seq2" sourceRef="_validateOrder" targetRef="_checkStatus"/>
    <bpmn2:sequenceFlow id="_seq3" sourceRef="_checkStatus" targetRef="_approved" name="Approved">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return order.getStatus().equals("APPROVED");]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_seq4" sourceRef="_checkStatus" targetRef="_rejected" name="Rejected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return order.getStatus().equals("REJECTED");]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:startEvent id="_start" name="Start">
      <bpmn2:outgoing>_seq1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:businessRuleTask id="_validateOrder" drools:ruleFlowGroup="unit:com.example.upgrade.OrderValidationUnit" name="Validate Order" implementation="http://www.jboss.org/drools/rule">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Validate Order]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_seq1</bpmn2:incoming>
      <bpmn2:outgoing>_seq2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_validateOrder_orderInputX" drools:dtype="com.example.upgrade.Order" itemSubjectRef="__validateOrder_orderInputXItem" name="order"/>
        <bpmn2:dataOutput id="_validateOrder_orderOutputX" drools:dtype="com.example.upgrade.Order" itemSubjectRef="__validateOrder_orderOutputXItem" name="order"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_validateOrder_orderInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_validateOrder_orderOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>order</bpmn2:sourceRef>
        <bpmn2:targetRef>_validateOrder_orderInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_validateOrder_orderOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>order</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:businessRuleTask>
    <bpmn2:exclusiveGateway id="_checkStatus" name="Check Status" gatewayDirection="Diverging">
      <bpmn2:incoming>_seq2</bpmn2:incoming>
      <bpmn2:outgoing>_seq3</bpmn2:outgoing>
      <bpmn2:outgoing>_seq4</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="_approved" name="Approved">
      <bpmn2:incoming>_seq3</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="_rejected" name="Rejected">
      <bpmn2:incoming>_seq4</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="_diagram">
    <bpmndi:BPMNPlane id="_plane" bpmnElement="orderValidationProcess">
      <bpmndi:BPMNShape id="shape__start" bpmnElement="_start">
        <dc:Bounds height="56.0" width="56.0" x="100.0" y="100.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__validateOrder" bpmnElement="_validateOrder">
        <dc:Bounds height="102.0" width="154.0" x="250.0" y="77.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__checkStatus" bpmnElement="_checkStatus">
        <dc:Bounds height="56.0" width="56.0" x="500.0" y="100.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__approved" bpmnElement="_approved">
        <dc:Bounds height="56.0" width="56.0" x="650.0" y="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__rejected" bpmnElement="_rejected">
        <dc:Bounds height="56.0" width="56.0" x="650.0" y="150.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge__start_to__validateOrder" bpmnElement="_seq1">
        <di:waypoint xsi:type="dc:Point" x="156.0" y="128.0"/>
        <di:waypoint xsi:type="dc:Point" x="250.0" y="128.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge__validateOrder_to__checkStatus" bpmnElement="_seq2">
        <di:waypoint xsi:type="dc:Point" x="404.0" y="128.0"/>
        <di:waypoint xsi:type="dc:Point" x="500.0" y="128.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge__checkStatus_to__approved" bpmnElement="_seq3">
        <di:waypoint xsi:type="dc:Point" x="528.0" y="100.0"/>
        <di:waypoint xsi:type="dc:Point" x="650.0" y="78.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge__checkStatus_to__rejected" bpmnElement="_seq4">
        <di:waypoint xsi:type="dc:Point" x="528.0" y="156.0"/>
        <di:waypoint xsi:type="dc:Point" x="650.0" y="178.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
