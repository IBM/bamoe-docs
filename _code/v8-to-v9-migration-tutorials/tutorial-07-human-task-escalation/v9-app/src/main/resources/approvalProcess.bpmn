<?xml version="1.0" encoding="UTF-8" ?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_definitions" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_requestorItem" structureRef="String" />
  <bpmn2:itemDefinition id="_amountItem" structureRef="Double" />
  <bpmn2:itemDefinition id="_approvedItem" structureRef="Boolean" />
  <bpmn2:itemDefinition id="__reviewTask_NotStartedReassignInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__reviewTask_NotCompletedReassignInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__reviewTask_NotCompletedNotifyInputXItem" structureRef="Object" />
  <bpmn2:process id="approvalProcess" drools:packageName="com.example.humantask" drools:version="1.0" name="Approval Process" isExecutable="true">
    <bpmn2:property id="requestor" itemSubjectRef="_requestorItem" name="requestor" />
    <bpmn2:property id="amount" itemSubjectRef="_amountItem" name="amount" />
    <bpmn2:property id="approved" itemSubjectRef="_approvedItem" name="approved" />
    <bpmn2:endEvent id="_end" name="End">
      <bpmn2:incoming>_review-to-end</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="_start-to-review" sourceRef="_start" targetRef="_reviewTask" />
    <bpmn2:sequenceFlow id="_review-to-end" sourceRef="_reviewTask" targetRef="_end" />
    <bpmn2:startEvent id="_start" name="Start">
      <bpmn2:outgoing>_start-to-review</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="_reviewTask" name="Review Request">
      <bpmn2:incoming>_start-to-review</bpmn2:incoming>
      <bpmn2:outgoing>_review-to-end</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_reviewTask_TaskNameInputX" name="TaskName" />
        <bpmn2:dataInput id="_reviewTask_SkippableInputX" name="Skippable" />
        <bpmn2:dataInput id="_reviewTask_PriorityInputX" name="Priority" />
        <bpmn2:dataInput id="_reviewTask_ActorIdInputX" name="ActorId" />
        <bpmn2:dataInput id="_reviewTask_GroupIdInputX" name="GroupId" />
        <bpmn2:dataInput id="_reviewTask_NotStartedReassignInputX" itemSubjectRef="__reviewTask_NotStartedReassignInputXItem" name="NotStartedReassign" />
        <bpmn2:dataInput id="_reviewTask_NotCompletedReassignInputX" itemSubjectRef="__reviewTask_NotCompletedReassignInputXItem" name="NotCompletedReassign" />
        <bpmn2:dataInput id="_reviewTask_NotCompletedNotifyInputX" itemSubjectRef="__reviewTask_NotCompletedNotifyInputXItem" name="NotCompletedNotify" />
        <bpmn2:dataInput id="_reviewTask_requestorInputX" name="requestor" />
        <bpmn2:dataInput id="_reviewTask_amountInputX" name="amount" />
        <bpmn2:dataOutput id="_reviewTask_approvedOutputX" name="approved" />
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_reviewTask_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_SkippableInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_PriorityInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_ActorIdInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_GroupIdInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_NotStartedReassignInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_NotCompletedReassignInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_NotCompletedNotifyInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_requestorInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_amountInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_reviewTask_approvedOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">review_request</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_TaskNameInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <!-- ActorId assignment for Section A (ws-human-task lifecycle) -->
      <!-- Comment out for Section B (default Kogito lifecycle) -->
     <!-- <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_ActorIdInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">admin</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_ActorIdInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation> -->
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_GroupIdInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">reviewers</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_GroupIdInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_SkippableInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">false</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_SkippableInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_PriorityInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">5</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_PriorityInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_NotStartedReassignInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">[users:supervisor]@[PT3S]</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_NotStartedReassignInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_NotCompletedReassignInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">[users:manager|groups:management]@[PT90S]</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_NotCompletedReassignInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_reviewTask_NotCompletedNotifyInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">[from:noreply@example.com|tousers:|togroups:|toemails:manager@example.com|replyTo:|subject:Action Needed for review_request task|body:Dear user,

This is a reminder that the review_request task is now pending your action. Please review the task details and complete the required steps at your earliest convenience.]@[PT90S]</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_reviewTask_NotCompletedNotifyInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>requestor</bpmn2:sourceRef>
        <bpmn2:targetRef>_reviewTask_requestorInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>amount</bpmn2:sourceRef>
        <bpmn2:targetRef>_reviewTask_amountInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_reviewTask_approvedOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>approved</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="_56AF1986-0EBC-480D-8BE3-8A777FB46BD6">
    <bpmndi:BPMNPlane bpmnElement="approvalProcess" id="_4DAA6B72-971E-4C03-A2D7-F4AC065AAC2D">
      <bpmndi:BPMNShape id="_start_di" bpmnElement="_start">
        <dc:Bounds x="100" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_reviewTask_di" bpmnElement="_reviewTask">
        <dc:Bounds x="200" y="78" width="154" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_end_di" bpmnElement="_end">
        <dc:Bounds x="420" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="_start-to-review_di" bpmnElement="_start-to-review">
        <di:waypoint x="118" y="118" />
        <di:waypoint x="200" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="_review-to-end_di" bpmnElement="_review-to-end">
        <di:waypoint x="354" y="118" />
        <di:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
