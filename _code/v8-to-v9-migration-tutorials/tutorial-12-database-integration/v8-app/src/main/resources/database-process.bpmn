<?xml version="1.0" encoding="UTF-8" ?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_database-process" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd http://www.bpsim.org/schemas/1.0 bpsim.xsd http://www.omg.org/spec/DD/20100524/DC DC.xsd http://www.omg.org/spec/DD/20100524/DI DI.xsd" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_queryItem" structureRef="String" />
  <bpmn2:itemDefinition id="_resultsItem" structureRef="com.example.database.model.QueryResult" />
  <bpmn2:itemDefinition id="_rowCountItem" structureRef="Integer" />
  <bpmn2:itemDefinition id="_approvedItem" structureRef="Boolean" />
  <bpmn2:itemDefinition id="_commentsItem" structureRef="String" />
  <bpmn2:process id="database-process" drools:packageName="com.example.database" drools:version="1.0" drools:adHoc="false" name="database-process" isExecutable="true" processType="Public">
    <bpmn2:property id="query" itemSubjectRef="_queryItem" name="query" />
    <bpmn2:property id="results" itemSubjectRef="_resultsItem" name="results" />
    <bpmn2:property id="rowCount" itemSubjectRef="_rowCountItem" name="rowCount" />
    <bpmn2:property id="approved" itemSubjectRef="_approvedItem" name="approved" />
    <bpmn2:property id="comments" itemSubjectRef="_commentsItem" name="comments" />
    <bpmn2:startEvent id="_startEvent" name="Start">
      <bpmn2:outgoing>_flow1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="_endEvent" name="End">
      <bpmn2:incoming>_flow3</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="_timerEndEvent" name="Escalation_End">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>Escalation End</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flowTimer</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:task id="_databaseTask" drools:taskName="DatabaseTask" name="Execute_Database_Query">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>Execute Database Query</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow1</bpmn2:incoming>
      <bpmn2:outgoing>_flow2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_databaseTask_QueryInputX" drools:dtype="String" itemSubjectRef="_queryItem" name="Query" />
        <bpmn2:dataOutput id="_databaseTask_ResultsOutputX" drools:dtype="com.example.database.model.QueryResult" itemSubjectRef="_resultsItem" name="Results" />
        <bpmn2:dataOutput id="_databaseTask_RowCountOutputX" drools:dtype="Integer" itemSubjectRef="_rowCountItem" name="RowCount" />
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_databaseTask_QueryInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_databaseTask_ResultsOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_databaseTask_RowCountOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>query</bpmn2:sourceRef>
        <bpmn2:targetRef>_databaseTask_QueryInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_databaseTask_ResultsOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>results</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_databaseTask_RowCountOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>rowCount</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>
    <bpmn2:userTask id="_reviewTask" name="ReviewQueryResults">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>ReviewQueryResults</drools:metaValue>
        </drools:metaData>
        <drools:metaData name="taskName">
          <drools:metaValue>ReviewQueryResults</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow2</bpmn2:incoming>
      <bpmn2:outgoing>_flow3</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_reviewTask_QueryInputX" drools:dtype="String" itemSubjectRef="_queryItem" name="query" />
        <bpmn2:dataInput id="_reviewTask_RowCountInputX" drools:dtype="Integer" itemSubjectRef="_rowCountItem" name="rowCount" />
        <bpmn2:dataInput id="_reviewTask_ResultsInputX" drools:dtype="com.example.database.model.QueryResult" itemSubjectRef="_resultsItem" name="results" />
        <bpmn2:dataOutput id="_reviewTask_ApprovedOutputX" drools:dtype="Boolean" itemSubjectRef="_approvedItem" name="approved" />
        <bpmn2:dataOutput id="_reviewTask_CommentsOutputX" drools:dtype="String" itemSubjectRef="_commentsItem" name="comments" />
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_reviewTask_QueryInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_RowCountInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_reviewTask_ResultsInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_reviewTask_ApprovedOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_reviewTask_CommentsOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>query</bpmn2:sourceRef>
        <bpmn2:targetRef>_reviewTask_QueryInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>rowCount</bpmn2:sourceRef>
        <bpmn2:targetRef>_reviewTask_RowCountInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>results</bpmn2:sourceRef>
        <bpmn2:targetRef>_reviewTask_ResultsInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_reviewTask_ApprovedOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>approved</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_reviewTask_CommentsOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>comments</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:potentialOwner>
        <bpmn2:resourceAssignmentExpression>
          <bpmn2:formalExpression>john</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>
    <bpmn2:boundaryEvent id="_timerBoundary" name="ReviewTimeout" attachedToRef="_reviewTask" cancelActivity="true">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>ReviewTimeout</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_flowTimer</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="_timerDef">
        <bpmn2:timeDuration xsi:type="bpmn2:tFormalExpression">PT30M</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="_flow1" sourceRef="_startEvent" targetRef="_databaseTask" />
    <bpmn2:sequenceFlow id="_flow2" sourceRef="_databaseTask" targetRef="_reviewTask" />
    <bpmn2:sequenceFlow id="_flow3" sourceRef="_reviewTask" targetRef="_endEvent" />
    <bpmn2:sequenceFlow id="_flowTimer" sourceRef="_timerBoundary" targetRef="_timerEndEvent" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="_4C60FE3B-E99F-4996-95D5-7D80A1CA9FF0">
    <bpmndi:BPMNPlane bpmnElement="database-process" id="_D9308908-73D8-4555-956E-1C989A0B67DE">
      <bpmndi:BPMNShape id="shape__startEvent" bpmnElement="_startEvent">
        <dc:Bounds height="56" width="56" x="50" y="122" />
      </bpmndi:BPMNShape>
