<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_ApprovalWithDeadline" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_requestItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_approverItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_approvedItem" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_SkippableInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_PriorityInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_CommentInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_DescriptionInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_CreatedByInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_TaskNameInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_GroupIdInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_ContentInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_NotStartedReassignInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_NotCompletedReassignInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_NotStartedNotifyInputXItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_NotCompletedNotifyInputXItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_requestInputXItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__UserTask_Approval_approvedOutputXItem" structureRef="Boolean"/>
  <bpmn2:process id="approvalWithDeadline" drools:packageName="com.example.notifications" drools:version="1.0" drools:adHoc="false" name="Approval Process with Deadline" isExecutable="true" processType="Public">
    <bpmn2:property id="request" itemSubjectRef="_requestItem" name="request"/>
    <bpmn2:property id="approver" itemSubjectRef="_approverItem" name="approver"/>
    <bpmn2:property id="approved" itemSubjectRef="_approvedItem" name="approved"/>
    <bpmn2:sequenceFlow id="_SequenceFlow_1" sourceRef="_StartEvent_1" targetRef="_UserTask_Approval"/>
    <bpmn2:sequenceFlow id="_SequenceFlow_2" sourceRef="_UserTask_Approval" targetRef="_EndEvent_1"/>
    <bpmn2:startEvent id="_StartEvent_1" name="Start">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Start]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_SequenceFlow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="_UserTask_Approval" name="Approve Request">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Approve Request]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customNotificationTemplate">
          <drools:metaValue><![CDATA[Task Approve Request requires your attention. Request: #{request}]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SequenceFlow_1</bpmn2:incoming>
      <bpmn2:outgoing>_SequenceFlow_2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_UserTask_Approval_TaskNameInputX" drools:dtype="Object" itemSubjectRef="__UserTask_Approval_TaskNameInputXItem" name="TaskName"/>
        <bpmn2:dataInput id="_UserTask_Approval_requestInputX" drools:dtype="String" itemSubjectRef="__UserTask_Approval_requestInputXItem" name="request"/>
        <bpmn2:dataInput id="_UserTask_Approval_SkippableInputX" drools:dtype="Object" itemSubjectRef="__UserTask_Approval_SkippableInputXItem" name="Skippable"/>
        <bpmn2:dataInput id="_UserTask_Approval_GroupIdInputX" drools:dtype="Object" itemSubjectRef="__UserTask_Approval_GroupIdInputXItem" name="GroupId"/>
        <bpmn2:dataInput id="_UserTask_Approval_NotStartedNotifyInputX" drools:dtype="String" itemSubjectRef="__UserTask_Approval_NotStartedNotifyInputXItem" name="NotStartedNotify"/>
        <bpmn2:dataInput id="_UserTask_Approval_NotCompletedNotifyInputX" drools:dtype="String" itemSubjectRef="__UserTask_Approval_NotCompletedNotifyInputXItem" name="NotCompletedNotify"/>
        <bpmn2:dataOutput id="_UserTask_Approval_approvedOutputX" drools:dtype="Boolean" itemSubjectRef="__UserTask_Approval_approvedOutputXItem" name="approved"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_UserTask_Approval_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_UserTask_Approval_requestInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_UserTask_Approval_SkippableInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_UserTask_Approval_GroupIdInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_UserTask_Approval_NotStartedNotifyInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_UserTask_Approval_NotCompletedNotifyInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_UserTask_Approval_approvedOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_UserTask_Approval_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[ApproveRequest]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_UserTask_Approval_TaskNameInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>request</bpmn2:sourceRef>
        <bpmn2:targetRef>_UserTask_Approval_requestInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_UserTask_Approval_SkippableInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[false]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_UserTask_Approval_SkippableInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_UserTask_Approval_GroupIdInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[approvers]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_UserTask_Approval_GroupIdInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_UserTask_Approval_NotStartedNotifyInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[[from:noreply@example.com|tousers:|togroups:|toemails:jdoe@example.com|replyTo:support@example.com|subject:Task Deadline Notification|body:Task Approve Request requires your attention. Request: #{request}]@[PT2M]]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_UserTask_Approval_NotStartedNotifyInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_UserTask_Approval_NotCompletedNotifyInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[[from:noreply@example.com|tousers:|togroups:|toemails:jdoe@example.com|replyTo:support@example.com|subject:Task Completion Reminder|body:Task Approve Request is still pending completion. Request: #{request}. Please complete this task as soon as possible.]@[PT5M]]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_UserTask_Approval_NotCompletedNotifyInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_UserTask_Approval_approvedOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>approved</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>
    <bpmn2:endEvent id="_EndEvent_1" name="End">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[End]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SequenceFlow_2</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="approvalWithDeadline">
      <bpmndi:BPMNShape id="shape__EndEvent_1" bpmnElement="_EndEvent_1">
        <dc:Bounds height="56" width="56" x="632" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__UserTask_Approval" bpmnElement="_UserTask_Approval">
        <dc:Bounds height="102" width="154" x="338" y="77"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__StartEvent_1" bpmnElement="_StartEvent_1">
        <dc:Bounds height="56" width="56" x="100" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_shape__UserTask_Approval_to_shape__EndEvent_1" bpmnElement="_SequenceFlow_2">
        <di:waypoint x="492" y="128"/>
        <di:waypoint x="632" y="128"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_shape__StartEvent_1_to_shape__UserTask_Approval" bpmnElement="_SequenceFlow_1">
        <di:waypoint x="156" y="128"/>
        <di:waypoint x="338" y="128"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>


