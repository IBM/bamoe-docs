<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<deployment-descriptor xsi:schemaLocation="http://www.jboss.org/jbpm deployment-descriptor.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <persistence-unit>org.jbpm.domain</persistence-unit>
    <audit-persistence-unit>org.jbpm.domain</audit-persistence-unit>
    <audit-mode>JPA</audit-mode>
    <persistence-mode>JPA</persistence-mode>
    <runtime-strategy>SINGLETON</runtime-strategy>
    <marshalling-strategies/>
    <event-listeners>
        <!-- Process Event Listener -->
        <event-listener>
            <resolver>mvel</resolver>
            <identifier>new com.example.listeners.ProcessEventLogger()</identifier>
            <parameters/>
        </event-listener>
        
        <!-- Task Life Cycle Event Listener -->
        <event-listener>
            <resolver>mvel</resolver>
            <identifier>new com.example.listeners.TaskLifeCycleListener()</identifier>
            <parameters/>
        </event-listener>
        
        <!-- Rule Event Listener -->
        <event-listener>
            <resolver>mvel</resolver>
            <identifier>new com.example.listeners.RuleEventLogger()</identifier>
            <parameters/>
        </event-listener>
    </event-listeners>
    <task-event-listeners/>
    <globals/>
    <work-item-handlers/>
    <environment-entries/>
    <configurations/>
    <required-roles/>
    <remoteable-classes/>
    <limit-serialization-classes>true</limit-serialization-classes>
</deployment-descriptor>


