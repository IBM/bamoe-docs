        "Username" : new StringDataType(),
        "Password" : new StringDataType(),
        "ConnectTimeout" : new StringDataType(),
        "ReadTimeout" : new StringDataType()
    ],
    "results" : [
        "Result" : new ObjectDataType()
    ],
    "icon" : "defaultservicenodeicon.png"
  ]
