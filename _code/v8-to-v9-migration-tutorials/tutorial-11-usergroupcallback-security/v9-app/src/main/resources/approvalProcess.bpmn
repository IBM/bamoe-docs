<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_definitions" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_requestItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_approvedItem" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="_approverCommentsItem" structureRef="String"/>
  <bpmn2:process id="approvalProcess" drools:packageName="com.example.security" drools:version="1.0" drools:adHoc="false" name="Approval Process with User Task" isExecutable="true" processType="Public">
    <bpmn2:property id="request" itemSubjectRef="_requestItem" name="request"/>
    <bpmn2:property id="approved" itemSubjectRef="_approvedItem" name="approved"/>
    <bpmn2:property id="approverComments" itemSubjectRef="_approverCommentsItem" name="approverComments"/>
    <bpmn2:sequenceFlow id="_flow1" sourceRef="_startEvent" targetRef="_userTask"/>
    <bpmn2:sequenceFlow id="_flow2" sourceRef="_userTask" targetRef="_scriptTask"/>
    <bpmn2:sequenceFlow id="_flow3" sourceRef="_scriptTask" targetRef="_endEvent"/>
    <bpmn2:startEvent id="_startEvent" name="Start">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Start]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_flow1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="_userTask" name="ApproveRequest">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[ApproveRequest]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow1</bpmn2:incoming>
      <bpmn2:outgoing>_flow2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_userTask_requestInputX" drools:dtype="String" itemSubjectRef="_requestItem" name="request"/>
        <bpmn2:dataInput id="_userTask_TaskNameInputX" drools:dtype="String" name="TaskName"/>
        <bpmn2:dataInput id="_userTask_GroupIdInputX" drools:dtype="String" name="GroupId"/>
        <bpmn2:dataOutput id="_userTask_approvedOutputX" drools:dtype="Boolean" itemSubjectRef="_approvedItem" name="approved"/>
        <bpmn2:dataOutput id="_userTask_approverCommentsOutputX" drools:dtype="String" itemSubjectRef="_approverCommentsItem" name="approverComments"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_userTask_requestInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_userTask_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_userTask_GroupIdInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_userTask_approvedOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>_userTask_approverCommentsOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>request</bpmn2:sourceRef>
        <bpmn2:targetRef>_userTask_requestInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_userTask_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[ApproveRequest]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_userTask_TaskNameInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_userTask_GroupIdInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[approver]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_userTask_GroupIdInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_userTask_approvedOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>approved</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_userTask_approverCommentsOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>approverComments</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:potentialOwner>
        <bpmn2:resourceAssignmentExpression>
          <bpmn2:formalExpression>john,mary,alice</bpmn2:formalExpression>
        </bpmn2:resourceAssignmentExpression>
      </bpmn2:potentialOwner>
    </bpmn2:userTask>
    <bpmn2:scriptTask id="_scriptTask" name="Log Approval" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Log Approval]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow2</bpmn2:incoming>
      <bpmn2:outgoing>_flow3</bpmn2:outgoing>
      <bpmn2:script>System.out.println("Approval request: " + request);
System.out.println("Approved: " + approved);
System.out.println("Comments: " + approverComments);</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:endEvent id="_endEvent" name="End">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[End]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_flow3</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="approvalProcess">
      <bpmndi:BPMNShape id="shape__endEvent" bpmnElement="_endEvent">
        <dc:Bounds height="56" width="56" x="700" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__scriptTask" bpmnElement="_scriptTask">
        <dc:Bounds height="102" width="154" x="500" y="77"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__userTask" bpmnElement="_userTask">
        <dc:Bounds height="102" width="154" x="300" y="77"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__startEvent" bpmnElement="_startEvent">
        <dc:Bounds height="56" width="56" x="100" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_shape__scriptTask_to_shape__endEvent" bpmnElement="_flow3">
        <di:waypoint x="654" y="128"/>
        <di:waypoint x="700" y="128"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_shape__userTask_to_shape__scriptTask" bpmnElement="_flow2">
        <di:waypoint x="454" y="128"/>
        <di:waypoint x="500" y="128"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_shape__startEvent_to_shape__userTask" bpmnElement="_flow1">
        <di:waypoint x="156" y="128"/>
        <di:waypoint x="300" y="128"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>



