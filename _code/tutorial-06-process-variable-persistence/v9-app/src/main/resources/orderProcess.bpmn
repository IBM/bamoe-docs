<bpmn2:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:bpsim="http://www.bpsim.org/schemas/1.0"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:drools="http://www.jboss.org/drools"
  id="_orderProcessDefinition"
  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd http://www.jboss.org/drools drools.xsd http://www.bpsim.org/schemas/1.0 bpsim.xsd http://www.omg.org/spec/DD/20100524/DC DC.xsd http://www.omg.org/spec/DD/20100524/DI DI.xsd "
  exporter="jBPM Process Modeler"
  exporterVersion="2.0"
  targetNamespace="http://www.omg.org/bpmn20"
>
  <!-- Item Definitions for Process Variables -->
  <bpmn2:itemDefinition id="_orderItem" structureRef="com.example.persistence.Order" />
  <bpmn2:itemDefinition id="_approvalDecisionItem" structureRef="String" />
  
  <!-- Item Definitions for User Task -->
  <bpmn2:itemDefinition id="__ApproveOrder_SkippableInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_PriorityInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_CommentInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_DescriptionInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_CreatedByInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_TaskNameInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_GroupIdInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_ContentInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_NotStartedReassignInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_NotCompletedReassignInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_NotStartedNotifyInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_NotCompletedNotifyInputXItem" structureRef="Object" />
  <bpmn2:itemDefinition id="__ApproveOrder_orderInputXItem" structureRef="com.example.persistence.Order" />
  <bpmn2:itemDefinition id="__ApproveOrder_decisionOutputXItem" structureRef="String" />

  <bpmn2:process
    id="orderProcess"
    drools:packageName="com.example.persistence"
    drools:version="1.0"
    drools:adHoc="false"
    name="Order Processing"
    isExecutable="true"
    processType="Public"
  >
    <!-- Process Variables -->
    <bpmn2:property id="order" itemSubjectRef="_orderItem" name="order">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[input,required]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>
    <bpmn2:property id="approvalDecision" itemSubjectRef="_approvalDecisionItem" name="approvalDecision">
      <bpmn2:extensionElements>
        <drools:metaData name="customTags">
          <drools:metaValue><![CDATA[internal]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
    </bpmn2:property>

    <!-- Sequence Flows -->
    <bpmn2:sequenceFlow id="_SF_Start_InitOrder" sourceRef="_StartEvent" targetRef="_InitOrder" />
    <bpmn2:sequenceFlow id="_SF_InitOrder_ApproveOrder" sourceRef="_InitOrder" targetRef="_ApproveOrder" />
    <bpmn2:sequenceFlow id="_SF_ApproveOrder_Gateway" sourceRef="_ApproveOrder" targetRef="_ApprovalGateway" />
    <bpmn2:sequenceFlow id="_SF_Gateway_Approved" name="Approved" sourceRef="_ApprovalGateway" targetRef="_MarkApproved">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return approvalDecision != null && approvalDecision.equals("APPROVE");]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_Gateway_Rejected" name="Rejected" sourceRef="_ApprovalGateway" targetRef="_MarkRejected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return approvalDecision == null || !approvalDecision.equals("APPROVE");]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF_Approved_EndApproved" sourceRef="_MarkApproved" targetRef="_EndApproved" />
    <bpmn2:sequenceFlow id="_SF_Rejected_EndRejected" sourceRef="_MarkRejected" targetRef="_EndRejected" />

    <!-- Start Event -->
    <bpmn2:startEvent id="_StartEvent" name="Start Order Process">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Start Order Process]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>_SF_Start_InitOrder</bpmn2:outgoing>
    </bpmn2:startEvent>

    <!-- Script Task: Initialize Order -->
    <bpmn2:scriptTask id="_InitOrder" name="Initialize Order" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Initialize Order]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_Start_InitOrder</bpmn2:incoming>
      <bpmn2:outgoing>_SF_InitOrder_ApproveOrder</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("Processing order: " + order.getOrderId());
System.out.println("Customer: " + order.getCustomerName());
System.out.println("Total Amount: " + order.getTotalAmount());
order.setStatus("PROCESSING");]]></bpmn2:script>
    </bpmn2:scriptTask>

    <!-- User Task: Approve Order -->
    <bpmn2:userTask id="_ApproveOrder" name="Approve Order">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Approve Order]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_InitOrder_ApproveOrder</bpmn2:incoming>
      <bpmn2:outgoing>_SF_ApproveOrder_Gateway</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_ApproveOrder_TaskNameInputX" drools:dtype="Object" itemSubjectRef="__ApproveOrder_TaskNameInputXItem" name="TaskName" />
        <bpmn2:dataInput id="_ApproveOrder_SkippableInputX" drools:dtype="Object" itemSubjectRef="__ApproveOrder_SkippableInputXItem" name="Skippable" />
        <bpmn2:dataInput id="_ApproveOrder_orderInputX" drools:dtype="com.example.persistence.Order" itemSubjectRef="__ApproveOrder_orderInputXItem" name="order" />
        <bpmn2:dataOutput id="_ApproveOrder_decisionOutputX" drools:dtype="String" itemSubjectRef="__ApproveOrder_decisionOutputXItem" name="decision" />
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_ApproveOrder_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_ApproveOrder_SkippableInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_ApproveOrder_orderInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_ApproveOrder_decisionOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_ApproveOrder_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[ApproveOrder]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_ApproveOrder_TaskNameInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_ApproveOrder_SkippableInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[false]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[_ApproveOrder_SkippableInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>order</bpmn2:sourceRef>
        <bpmn2:targetRef>_ApproveOrder_orderInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_ApproveOrder_decisionOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>approvalDecision</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>

    <!-- Exclusive Gateway: Check Approval -->
    <bpmn2:exclusiveGateway id="_ApprovalGateway" name="Approved?" gatewayDirection="Diverging">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Approved?]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_ApproveOrder_Gateway</bpmn2:incoming>
      <bpmn2:outgoing>_SF_Gateway_Approved</bpmn2:outgoing>
      <bpmn2:outgoing>_SF_Gateway_Rejected</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- Script Task: Mark Approved -->
    <bpmn2:scriptTask id="_MarkApproved" name="Mark Approved" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Mark Approved]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_Gateway_Approved</bpmn2:incoming>
      <bpmn2:outgoing>_SF_Approved_EndApproved</bpmn2:outgoing>
      <bpmn2:script><![CDATA[order.setApproved(true);
order.setStatus("APPROVED");
System.out.println("Order " + order.getOrderId() + " approved");]]></bpmn2:script>
    </bpmn2:scriptTask>

    <!-- Script Task: Mark Rejected -->
    <bpmn2:scriptTask id="_MarkRejected" name="Mark Rejected" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Mark Rejected]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_Gateway_Rejected</bpmn2:incoming>
      <bpmn2:outgoing>_SF_Rejected_EndRejected</bpmn2:outgoing>
      <bpmn2:script><![CDATA[order.setApproved(false);
order.setStatus("REJECTED");
System.out.println("Order " + order.getOrderId() + " rejected");]]></bpmn2:script>
    </bpmn2:scriptTask>

    <!-- End Event: Approved -->
    <bpmn2:endEvent id="_EndApproved" name="Order Approved">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Order Approved]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_Approved_EndApproved</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- End Event: Rejected -->
    <bpmn2:endEvent id="_EndRejected" name="Order Rejected">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Order Rejected]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_SF_Rejected_EndRejected</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>

  <!-- BPMN Diagram -->
  <bpmndi:BPMNDiagram>
    <bpmndi:BPMNPlane bpmnElement="orderProcess">
      <!-- Start Event -->
      <bpmndi:BPMNShape id="shape__StartEvent" bpmnElement="_StartEvent">
        <dc:Bounds height="56" width="56" x="100" y="100" />
      </bpmndi:BPMNShape>
      
      <!-- Initialize Order -->
      <bpmndi:BPMNShape id="shape__InitOrder" bpmnElement="_InitOrder">
        <dc:Bounds height="102" width="154" x="236" y="77" />
      </bpmndi:BPMNShape>
      
      <!-- Approve Order -->
      <bpmndi:BPMNShape id="shape__ApproveOrder" bpmnElement="_ApproveOrder">
        <dc:Bounds height="102" width="154" x="470" y="77" />
      </bpmndi:BPMNShape>
      
      <!-- Approval Gateway -->
      <bpmndi:BPMNShape id="shape__ApprovalGateway" bpmnElement="_ApprovalGateway">
        <dc:Bounds height="56" width="56" x="704" y="100" />
      </bpmndi:BPMNShape>
      
      <!-- Mark Approved -->
      <bpmndi:BPMNShape id="shape__MarkApproved" bpmnElement="_MarkApproved">
        <dc:Bounds height="102" width="154" x="840" y="20" />
      </bpmndi:BPMNShape>
      
      <!-- Mark Rejected -->
      <bpmndi:BPMNShape id="shape__MarkRejected" bpmnElement="_MarkRejected">
        <dc:Bounds height="102" width="154" x="840" y="180" />
      </bpmndi:BPMNShape>
      
      <!-- End Approved -->
      <bpmndi:BPMNShape id="shape__EndApproved" bpmnElement="_EndApproved">
        <dc:Bounds height="56" width="56" x="1074" y="43" />
      </bpmndi:BPMNShape>
      
      <!-- End Rejected -->
      <bpmndi:BPMNShape id="shape__EndRejected" bpmnElement="_EndRejected">
        <dc:Bounds height="56" width="56" x="1074" y="203" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="edge__SF_Start_InitOrder" bpmnElement="_SF_Start_InitOrder">
        <di:waypoint x="128" y="128" />
        <di:waypoint x="236" y="128" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="edge__SF_InitOrder_ApproveOrder" bpmnElement="_SF_InitOrder_ApproveOrder">
        <di:waypoint x="390" y="128" />
        <di:waypoint x="470" y="128" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="edge__SF_ApproveOrder_Gateway" bpmnElement="_SF_ApproveOrder_Gateway">
        <di:waypoint x="624" y="128" />
        <di:waypoint x="704" y="128" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="edge__SF_Gateway_Approved" bpmnElement="_SF_Gateway_Approved">
        <di:waypoint x="732" y="100" />
        <di:waypoint x="732" y="71" />
        <di:waypoint x="840" y="71" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="edge__SF_Gateway_Rejected" bpmnElement="_SF_Gateway_Rejected">
        <di:waypoint x="732" y="156" />
        <di:waypoint x="732" y="231" />
        <di:waypoint x="840" y="231" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="edge__SF_Approved_EndApproved" bpmnElement="_SF_Approved_EndApproved">
        <di:waypoint x="994" y="71" />
        <di:waypoint x="1074" y="71" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="edge__SF_Rejected_EndRejected" bpmnElement="_SF_Rejected_EndRejected">
        <di:waypoint x="994" y="231" />
        <di:waypoint x="1074" y="231" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>

